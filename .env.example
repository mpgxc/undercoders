# Comentários via Giscus (GitHub Discussions).
# Estes valores são identificadores PÚBLICOS (não são segredos).
# Obtenha-os em https://giscus.app depois de habilitar Discussions no repositório
# e instalar o app https://github.com/apps/giscus.
#
# Copie este arquivo para .env.local (ignorado pelo git) ou configure as
# variáveis no painel da Vercel.

NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# Opcional — nome da categoria de Discussions (padrão: "Comments")
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
